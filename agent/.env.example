# 复制本文件为 agent/.env 后填写。不要把 .env 提交到 GitHub。
# 如果当前 PowerShell 已经用 $env: 设置过，可以不填，程序会优先使用已有环境变量。

IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=
IMA_SKILL_SCRIPT=C:\Users\ROG\Downloads\ima-skills-1.1.10\ima-skill\ima_api.cjs
IMA_KB_NAME=任德耀新建华为PC知识库

# 兼容 OpenAI 接口的公开大模型。换服务时只改下面三项。
# DeepSeek:  https://api.deepseek.com/v1          模型 deepseek-chat
# 通义千问:   https://dashscope.aliyuncs.com/compatible-mode/v1   模型 qwen-plus
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
